{
  "expo": {
    "name": "Porur Delivery",
    "slug": "porur-delivery",
    "scheme": "porurdelivery",
    "version": "0.6.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#16a34a"
    },
    "ios": {
      "bundleIdentifier": "com.porurdelivery.customer",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Speak your shopping list",
        "NSSpeechRecognitionUsageDescription": "Understand your spoken order",
        "NSPhotoLibraryUsageDescription": "Upload your prescription",
        "NSCameraUsageDescription": "Photograph your prescription"
      }
    },
    "android": {
      "package": "com.porurdelivery.customer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#16a34a"
      },
      "permissions": [
        "RECORD_AUDIO"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "photosPermission": "Upload your prescription",
          "cameraPermission": "Photograph your prescription"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Speak your shopping list",
          "speechRecognitionPermission": "Understand your spoken order",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "99bb3ec0-0382-4864-97cb-2d05d52d6f6d"
      }
    },
    "owner": "cv4591",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/99bb3ec0-0382-4864-97cb-2d05d52d6f6d",
      "fallbackToCacheTimeout": 0
    }
  }
}
