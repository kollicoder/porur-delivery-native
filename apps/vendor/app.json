{
  "expo": {
    "name": "Porur Delivery Partner",
    "slug": "porur-delivery-partner",
    "scheme": "porurpartner",
    "version": "0.6.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "bundleIdentifier": "com.porurdelivery.vendor",
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Understand your spoken deal",
        "NSMicrophoneUsageDescription": "Speak your surplus deal"
      }
    },
    "android": {
      "package": "com.porurdelivery.vendor",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "permissions": [
        "RECORD_AUDIO"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Speak your surplus deal",
          "speechRecognitionPermission": "Understand your spoken deal",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "144b9794-b5a6-4f5b-bc87-28bb26827b3d"
      }
    },
    "owner": "cv4591",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/144b9794-b5a6-4f5b-bc87-28bb26827b3d",
      "fallbackToCacheTimeout": 0
    }
  }
}
