rules_version = '2';
// Prototype rules: every request must be signed in (anonymous auth OK).
// Role comes from users/{uid}.role, which users currently pick themselves (demo role picker) —
// tighten before launch: set roles server-side (custom claims / admin-only writes) and use phone OTP.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role; }
    function isRole(rs) { return signedIn() && exists(/databases/$(db)/documents/users/$(request.auth.uid)) && role() in rs; }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid
                         && (!('role' in request.resource.data) || request.resource.data.role in ['customer','vendor','rider','admin']);
    }
    match /settings/{id} { allow read: if signedIn(); allow write: if isRole(['admin']); }
    match /stores/{id}   { allow read: if signedIn(); allow write: if isRole(['admin','vendor']); }
    match /products/{id} {
      allow read: if signedIn();
      allow create, delete: if isRole(['admin']);
      allow update: if isRole(['admin']) || (isRole(['vendor']) && onlyChanges(['price','inStock']));
    }
    match /riders/{id} {
      allow read: if signedIn();
      allow write: if isRole(['admin']) || (isRole(['rider']) && onlyChanges(['status','today']));
    }
    match /orders/{id} {
      allow read: if signedIn();
      allow create: if isRole(['admin']) || (signedIn() && request.resource.data.customerUid == request.auth.uid
                    && request.resource.data.status == 'placed');
      allow update: if isRole(['admin'])
        || (isRole(['vendor']) && onlyChanges(['status','rxStatus','updatedAt']))
        || (isRole(['rider'])  && onlyChanges(['status','updatedAt']))
        || (signedIn() && resource.data.customerUid == request.auth.uid && onlyChanges(['status','updatedAt']) && request.resource.data.status == 'rejected');
      allow delete: if isRole(['admin']);
    }
    match /errands/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.customerUid == request.auth.uid;
      allow update, delete: if isRole(['admin']);
    }
  }
}
